  <diagram id="scenario-login-correct-v3" name="Login Scenario Correct V3">
    <mxGraphModel dx="2500" dy="1450" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2500" pageHeight="1450" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;Login Scenario — SC-02&lt;/b&gt;&lt;br&gt;Correct example v3 · no text overflow · invariant at enforcement point" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0d1117;strokeColor=#30363d;fontColor=#f0f6fc;fontSize=13;spacing=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="700" y="20" width="1100" height="65" as="geometry"/></mxCell><mxCell id="actor" value="&lt;b&gt;Actor / Screen&lt;/b&gt;&lt;br&gt;&lt;br&gt;Actor: Guest&lt;br&gt;Screen: Login screen&lt;br&gt;Goal: Sign in&lt;br&gt;Level: L1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#121820;strokeColor=#b7c0cc;fontColor=#f0f6fc;fontSize=13;spacing=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="70" y="130" width="350" height="180" as="geometry"/></mxCell><mxCell id="pre" value="&lt;b&gt;Scenario Preconditions&lt;/b&gt;&lt;br&gt;&lt;br&gt;Guest is not signed in.&lt;br&gt;Login screen is reachable.&lt;br&gt;&lt;br&gt;SC-02-PRE-01..02" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#22250a;strokeColor=#9ca330;fontColor=#f0f6fc;fontSize=13;spacing=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="70" y="390" width="380" height="155" as="geometry"/></mxCell><mxCell id="open" value="&lt;b&gt;Open login screen&lt;/b&gt;&lt;br&gt;SC-02-STEP-01&lt;br&gt;[CORE]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f2019;strokeColor=#1f9d72;fontColor=#f0f6fc;fontSize=13;spacing=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="570" y="150" width="245" height="110" as="geometry"/></mxCell><mxCell id="enter" value="&lt;b&gt;Enter credentials&lt;/b&gt;&lt;br&gt;SC-02-STEP-02&lt;br&gt;[CORE]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f2019;strokeColor=#1f9d72;fontColor=#f0f6fc;fontSize=13;spacing=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="900" y="150" width="245" height="110" as="geometry"/></mxCell><mxCell id="submit" value="&lt;b&gt;Submit sign-in&lt;/b&gt;&lt;br&gt;SC-02-STEP-03&lt;br&gt;[CORE]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f2019;strokeColor=#1f9d72;fontColor=#f0f6fc;fontSize=13;spacing=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="1230" y="150" width="245" height="110" as="geometry"/></mxCell><mxCell id="include" value="&lt;b&gt;&amp;lt;&amp;lt;include&amp;gt;&amp;gt;&lt;/b&gt;&lt;br&gt;Validate login form&lt;br&gt;SC-02-INC-01&lt;br&gt;[CORE]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#10252c;strokeColor=#39b8d0;fontColor=#f0f6fc;fontSize=13;spacing=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="1220" y="365" width="280" height="110" as="geometry"/></mxCell><mxCell id="decision" value="&lt;b&gt;Credentials valid?&lt;/b&gt;&lt;br&gt;SC-02-BR-01&lt;br&gt;[CORE]" style="rhombus;whiteSpace=wrap;html=1;fillColor=#102232;strokeColor=#2f81b7;fontColor=#f0f6fc;fontSize=13;spacing=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="1570" y="120" width="275" height="175" as="geometry"/></mxCell><mxCell id="inv" value="&lt;b&gt;Invariant&lt;/b&gt;&lt;br&gt;Session only for valid credentials&lt;br&gt;SC-02-INV-01" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#242203;strokeColor=#8a7a00;fontColor=#f0f6fc;fontSize=13;spacing=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="1950" y="130" width="360" height="120" as="geometry"/></mxCell><mxCell id="session" value="&lt;b&gt;Session is issued&lt;/b&gt;&lt;br&gt;SC-02-SPOST-01&lt;br&gt;[CORE]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f2019;strokeColor=#1f9d72;fontColor=#f0f6fc;fontSize=13;spacing=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="1950" y="365" width="285" height="110" as="geometry"/></mxCell><mxCell id="redirect" value="&lt;b&gt;Redirect to requested app page&lt;/b&gt;&lt;br&gt;SC-02-POST-01&lt;br&gt;[CORE]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f2019;strokeColor=#1f9d72;fontColor=#f0f6fc;fontSize=13;spacing=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="1950" y="565" width="315" height="120" as="geometry"/></mxCell><mxCell id="error" value="&lt;b&gt;Show sign-in error&lt;/b&gt;&lt;br&gt;SC-02-SPOST-02&lt;br&gt;[CORE]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#271010;strokeColor=#d04a4a;fontColor=#f0f6fc;fontSize=13;spacing=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="1570" y="690" width="285" height="110" as="geometry"/></mxCell><mxCell id="unauth" value="&lt;b&gt;Remain unauthenticated&lt;/b&gt;&lt;br&gt;SC-02-POST-02&lt;br&gt;[CORE]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#271010;strokeColor=#d04a4a;fontColor=#f0f6fc;fontSize=13;spacing=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="1950" y="690" width="310" height="110" as="geometry"/></mxCell><mxCell id="forgot" value="&lt;b&gt;Forgot password selected&lt;/b&gt;&lt;br&gt;SC-02-EXTND-01" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1b122b;strokeColor=#8957e5;fontColor=#f0f6fc;fontSize=13;spacing=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="570" y="910" width="310" height="115" as="geometry"/></mxCell><mxCell id="recovery" value="&lt;b&gt;Open subscenario:&lt;/b&gt;&lt;br&gt;Password Recovery&lt;br&gt;SC-03" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1b122b;strokeColor=#8957e5;fontColor=#f0f6fc;fontSize=13;spacing=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="960" y="910" width="350" height="115" as="geometry"/></mxCell><mxCell id="end" value="&lt;b&gt;End states / Postconditions&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Valid login:&lt;/b&gt;&lt;br&gt;- session exists;&lt;br&gt;- requested app page opens.&lt;br&gt;&lt;br&gt;&lt;b&gt;Invalid login:&lt;/b&gt;&lt;br&gt;- no session exists;&lt;br&gt;- error is visible.&lt;br&gt;&lt;br&gt;&lt;b&gt;Recovery:&lt;/b&gt;&lt;br&gt;- Password Recovery scenario opens." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#102232;strokeColor=#2f81b7;fontColor=#f0f6fc;fontSize=13;spacing=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="1620" y="1020" width="510" height="320" as="geometry"/></mxCell><mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;&lt;br&gt;Green = current in-page flow&lt;br&gt;Red = negative/error branch&lt;br&gt;Purple = off-page/subscenario link&lt;br&gt;Blue = decision / end-state summary&lt;br&gt;Cyan = include&lt;br&gt;Yellow = invariant&lt;br&gt;Olive = precondition" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#121820;strokeColor=#b7c0cc;fontColor=#f0f6fc;fontSize=13;spacing=12;spacingTop=8;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="70" y="1020" width="430" height="245" as="geometry"/></mxCell><mxCell id="e1" value="starts" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#9aa4b2;fontColor=#dbeafe;" edge="1" parent="1" source="actor" target="open"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="condition for" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#a6a600;fontColor=#dbeafe;dashed=1;" edge="1" parent="1" source="pre" target="open"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="next" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#9aa4b2;fontColor=#dbeafe;" edge="1" parent="1" source="open" target="enter"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="next" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#9aa4b2;fontColor=#dbeafe;" edge="1" parent="1" source="enter" target="submit"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="checks" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#9aa4b2;fontColor=#dbeafe;" edge="1" parent="1" source="submit" target="decision"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="include" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#39b8d0;fontColor=#dbeafe;dashed=1;" edge="1" parent="1" source="submit" target="include"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="protected by" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#a6a600;fontColor=#dbeafe;dashed=1;" edge="1" parent="1" source="decision" target="inv"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="if valid" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#9aa4b2;fontColor=#dbeafe;" edge="1" parent="1" source="decision" target="session"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="results in" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#9aa4b2;fontColor=#dbeafe;" edge="1" parent="1" source="session" target="redirect"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="if invalid" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#d04a4a;fontColor=#dbeafe;" edge="1" parent="1" source="decision" target="error"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" value="results in" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#d04a4a;fontColor=#dbeafe;" edge="1" parent="1" source="error" target="unauth"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e12" valu